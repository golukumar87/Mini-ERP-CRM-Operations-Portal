# Node.js dependencies
node_modules/
**/node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
server/*.log
server/**/*.log

# Environment variables
.env
.env.*
**/.env
**/.env.*

# Build output
build/
dist/
out/
.client-build/
.coverage/
coverage/

# Framework / deployment artifacts
.next/
.vercel/
.firebase/
.cache/

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Temporary files
*.tmp
*.temp

# Local runtime files
*.pid
*.seed

# Optional: ignore lock files if you do not want to track them
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
echo "*.tsbuildinfo" >> .gitignore
echo "*.id" >> .gitignore
echo "*.txt" >> .gitignore